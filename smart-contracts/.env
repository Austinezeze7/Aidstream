# ======================================================
# AidStream Smart Contracts Environment Variables
# ======================================================

# ------------------------------------------------------
# WALLET PRIVATE KEY
# ------------------------------------------------------
# Exported from MetaMask
# NEVER share this publicly
# NEVER commit real keys to GitHub
#
# Example:
# PRIVATE_KEY=abc123...

PRIVATE_KEY=your_wallet_private_key_here

# ------------------------------------------------------
# RPC URL
# ------------------------------------------------------
# Polygon Amoy RPC Endpoint
#
# Get free RPC URLs from:
# - Alchemy
# - Infura
# - QuickNode
#
# Example:
# RPC_URL=https://polygon-amoy.g.alchemy.com/v2/xxxxx

RPC_URL=your_polygon_amoy_rpc_url_here

# ------------------------------------------------------
# POLYGONSCAN API KEY
# ------------------------------------------------------
# Used for smart contract verification
#
# Get from:
# https://polygonscan.com/apis

ETHERSCAN_API_KEY=your_polygonscan_api_key_here

# ------------------------------------------------------
# OPTIONAL SETTINGS
# ------------------------------------------------------

NETWORK=polygonAmoy
PORT=3000